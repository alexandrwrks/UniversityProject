<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>View/Resources/Store.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="View/Resources/Store.ico" />
    <Compile Remove="tmp/**/*.cs;tests/**/*.cs;demos/**/*.cs" />
    <EmbeddedResource Remove="tmp/**/*;tests/**/*;demos/**/*" />
    <None Remove="tmp/**/*;tests/**/*;demos/**/*" />
  </ItemGroup>
</Project>
